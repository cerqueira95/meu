{
  "expo": {
    "name": "Warehouse",
    "slug": "warehouse",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "warehouse",
    "icon": "./assets/icon.png",
    "backgroundColor": "#07111F",
    "primaryColor": "#4F8CFF",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.nexlog.warehouse",
      "buildNumber": "2",
      "supportsTablet": false,
      "icon": "./assets/icon.png",
      "userInterfaceStyle": "dark"
    },
    "androidStatusBar": {
      "backgroundColor": "#07111F",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#07111F",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.nexlog.warehouse",
      "versionCode": 2,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07111F"
      },
      "permissions": [
        "CAMERA"
      ],
      "userInterfaceStyle": "dark"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Warehouse usa a câmera para registrar evidências das atividades.",
          "photosPermission": "O Warehouse acessa suas fotos para anexar evidências das atividades.",
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07111F",
          "image": "./assets/splash-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#07111F",
            "image": "./assets/splash-logo.png"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
